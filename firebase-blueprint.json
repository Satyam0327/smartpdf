{
  "entities": {
    "User": {
      "title": "User",
      "description": "Stores user tracking data and compression usage quotas.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User's email address."
        },
        "usageCount": {
          "type": "number",
          "description": "Number of compressions performed today."
        },
        "lastUsedDate": {
          "type": "string",
          "description": "Date string of the last compression, used for daily resets."
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp of first login."
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["email", "usageCount", "lastUsedDate", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User documents keyed by their Firebase Auth UID."
    }
  }
}
